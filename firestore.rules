rules_version = '2';

// Fichman 5 ledger.
// - The owner always has access and manages sharing from the app ("שיתוף"),
//   which writes one document per shared email to /access/{email}. The list lives
//   in Firestore rather than in this file because the repo is public.
// - A shared user can read and edit the entries and see only their own access doc.
service cloud.firestore {
  match /databases/{database}/documents {

    // Google accounts come with a verified email. Password accounts are created by the owner in the
    // Firebase console (self sign-up is turned off), so they are trusted without verification.
    function signedIn() {
      return request.auth != null
          && (request.auth.token.email_verified == true
              || request.auth.token.firebase.sign_in_provider == 'password');
    }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'gavishori@gmail.com';
    }
    function allowed() {
      return isOwner()
          || (signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.token.email)));
    }
    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'date', 'cat', 'desc', 'amount', 'open', 'pay', 'payNote', 'order', 'updatedAt', 'updatedBy'])
          && d.kind in ['tenant', 'ledger']
          && d.amount is number
          && d.date is string && d.cat is string && d.desc is string
          && d.desc.size() < 5000;
    }

    match /entries/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed() && validEntry();
    }

    match /investments/{docId} {
      allow read, write: if allowed() && docId in ['data', 'mom'];
    }

    match /insurance/{docId} {
      allow read, write: if allowed() && docId in ['data', 'mom'];
    }

    // Small images (e.g. the photo for Mom's opening) as data URLs.
    match /media/{id} {
      allow read: if allowed();
      allow write: if allowed() && id in ['mom']
                   && request.resource.data.dataUrl is string
                   && request.resource.data.dataUrl.size() < 900000;
    }

    // The owner's own documents (extra tabs and their answers): nobody else, not even shared users.
    match /owner/{docId} {
      allow read, write: if isOwner();
    }

    match /access/{email} {
      allow read: if isOwner() || (signedIn() && request.auth.token.email == email);
      allow create, update: if isOwner()
                            && email == email.lower()
                            && request.resource.data.keys().hasOnly(['addedAt', 'addedBy']);
      allow delete: if isOwner();
    }
  }
}
